# ─────────────────────────────────────────────────────────────────────────────
# JobHook Express API — environment variables (TEMPLATE, safe to commit)
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# The variable names match the Spring Boot backend, so the same .env works for both.
# ─────────────────────────────────────────────────────────────────────────────

# Port to listen on (Render/Railway inject PORT automatically).
PORT=8080

# development | production | test
NODE_ENV=development

# MongoDB connection string. Use the SAME database as the Spring Boot backend to share data.
# Local:  mongodb://127.0.0.1:27017/jobportal
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority
# (SPRING_DATA_MONGODB_URI is also accepted, so you can reuse the Spring .env as-is.)
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal

# Secret used to sign JWTs (HS512). Use the SAME value as the Spring backend so tokens
# issued by one backend are accepted by the other. Long random string (64+ chars).
JWT_SECRET=replace-with-a-long-random-64-plus-character-secret

# Gmail account used to send OTP emails (Gmail App Password, not your normal password).
# If left empty in development, the OTP is printed to the server log instead.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Comma-separated list of allowed browser origins, or * for any (like Spring's @CrossOrigin).
CORS_ORIGINS=*

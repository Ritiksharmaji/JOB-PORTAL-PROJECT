# Copy to .env (git-ignored) to override defaults. Everything works without it.
# Use the same JWT_SECRET as the monolith if you want tokens to work on both.
JWT_SECRET=
# Leave empty to use the MongoDB container. For MongoDB Atlas, the cluster URI (no database name):
MONGODB_URI=
# Optional: Gmail address + app password for OTP emails (otherwise the OTP is printed in user-service logs)
MAIL_USERNAME=
MAIL_PASSWORD=
# Host port for the API gateway (the React app points REACT_APP_API_URL here)
GATEWAY_PORT=8080
# Timezone of the services; keep UTC to match data migrated from the live monolith
TZ=UTC

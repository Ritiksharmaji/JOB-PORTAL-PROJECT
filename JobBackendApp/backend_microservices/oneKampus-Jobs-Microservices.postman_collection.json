{
  "info": {
    "name": "oneKampus Jobs \u2014 Microservices (via API gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All requests go through the API gateway (baseUrl). Log in first: the token, userId and profileId are saved automatically."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "profileId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": "1"
    },
    {
      "key": "email",
      "value": "recruiter@example.test"
    },
    {
      "key": "password",
      "value": "Abcdef1@x"
    }
  ],
  "item": [
    {
      "name": "user-service",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Recruiter\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"accountType\": \"EMPLOYER\"\n}"
            }
          }
        },
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.jwt) { pm.collectionVariables.set(\"token\", d.jwt);",
                  "  const c = JSON.parse(atob(d.jwt.split(\".\")[1].replace(/-/g,\"+\").replace(/_/g,\"/\")));",
                  "  pm.collectionVariables.set(\"userId\", c.id); pm.collectionVariables.set(\"profileId\", c.profileId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/sendOtp/{{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "sendOtp",
                "{{email}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/verifyOtp/{{email}}/123456",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "verifyOtp",
                "{{email}}",
                "123456"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Change password (needs verified OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/changePass",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "changePass"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Newpass1@x\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "profile-service",
      "item": [
        {
          "name": "All profiles (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profiles/getAll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profiles",
                "getAll"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profiles/get/{{profileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profiles",
                "get",
                "{{profileId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profiles/update",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profiles",
                "update"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{profileId}}\",\n  \"name\": \"Recruiter\",\n  \"jobTitle\": \"Hiring Manager\",\n  \"skills\": [\n    \"Hiring\"\n  ],\n  \"savedJobs\": []\n}"
            }
          }
        }
      ]
    },
    {
      "name": "job-service",
      "item": [
        {
          "name": "All jobs (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/getAll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "getAll"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "One job (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/get/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "get",
                "{{jobId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Post job (recruiter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "post"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 0,\n  \"jobTitle\": \"Java Developer\",\n  \"company\": \"Google\",\n  \"about\": \"Spring Boot APIs\",\n  \"experience\": \"Intermediate\",\n  \"jobType\": \"Full Time\",\n  \"location\": \"Pune\",\n  \"packageOffered\": 12,\n  \"description\": \"<p>Build APIs</p>\",\n  \"skillsRequired\": [\n    \"Java\",\n    \"Spring Boot\"\n  ],\n  \"jobStatus\": \"ACTIVE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"jobId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Apply (job seeker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/apply/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "apply",
                "{{jobId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Seeker\",\n  \"email\": \"seeker@example.test\",\n  \"phone\": 9999999999,\n  \"website\": \"https://example.test\",\n  \"resume\": \"cmVzdW1l\",\n  \"coverLetter\": \"Hello\"\n}"
            }
          }
        },
        {
          "name": "My application history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/history/{{userId}}/APPLIED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "history",
                "{{userId}}",
                "APPLIED"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Jobs I posted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/postedBy/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "postedBy",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Schedule interview (poster)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/changeAppStatus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "changeAppStatus"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{jobId}}\",\n  \"applicantId\": 2,\n  \"applicationStatus\": \"INTERVIEWING\",\n  \"interviewTime\": \"2026-12-01T10:00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "notification-service",
      "item": [
        {
          "name": "My unread notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notification/get/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notification",
                "get",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Mark read",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notification/read/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notification",
                "read",
                "1"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}